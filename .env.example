# =============================================================================
# ir-soar environment variable reference
# Copy this file to `.env` and fill in real values for your environment.
# `.env` is gitignored — never commit real secrets.
#
# NOTHING in config.yaml ever contains a raw secret. config.yaml only stores
# the *name* of the environment variable that holds a secret (e.g.
# `api_key_env: ABUSEIPDB_API_KEY`). The engine reads the actual value from
# the process environment at runtime.
# =============================================================================

# --- Core run settings (override config.yaml) --------------------------------
# One of: lab | home | production-like
IR_SOAR_ENV=lab

# One of: dry-run | interactive | live
IR_SOAR_MODE=dry-run

# One of: DEBUG | INFO | WARNING | ERROR
IR_SOAR_LOG_LEVEL=INFO

# --- Paths (never hardcode these in code; always resolved via config/env) ----
IR_SOAR_LOG_DIR=./logs
IR_SOAR_AUDIT_LOG=./logs/audit.jsonl
IR_SOAR_PLAYBOOKS_DIR=./config/playbooks
IR_SOAR_EVIDENCE_DIR=./evidence

# --- Full-auto safety acknowledgement ----------------------------------------
# Full-auto mode requires an explicit, out-of-band acknowledgement in
# non-interactive contexts (CI, cron, scripted runs) since there is no
# operator present to answer the interactive confirmation prompt.
# Set to "true" only if you understand full-auto executes containment
# actions without a human approval step.
IR_SOAR_FULL_AUTO_ACK=false

# --- Connector credentials (future real integrations; simulated by default) --
# EDR / host isolation connector
EDR_API_ENDPOINT=
EDR_API_KEY=

# Identity provider connector (account disable/enable)
IDENTITY_API_ENDPOINT=
IDENTITY_API_KEY=

# Firewall / network block connector
FIREWALL_API_ENDPOINT=
FIREWALL_API_KEY=

# --- Enrichment provider credentials (simulated by default) ------------------
ABUSEIPDB_API_KEY=
VT_API_KEY=
WHOIS_API_KEY=
